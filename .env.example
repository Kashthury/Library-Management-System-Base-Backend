# ---------- PostgreSQL ----------
POSTGRES_DB=library_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# ---------- Spring Boot datasource (read by application.yml) ----------
DB_URL=jdbc:postgresql://localhost:5432/library_db
DB_USERNAME=postgres
DB_PASSWORD=change_me

# ---------- Frontend origins allowed by CORS (comma separated) ----------
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Business rules (optional overrides) ----------
LIBRARY_MAX_BOOKS_PER_STUDENT=5
LIBRARY_DEFAULT_LOAN_DAYS=14
LIBRARY_BLOCK_BORROW_WITH_OUTSTANDING_FINE=false
